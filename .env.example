# Copy to .env and fill in. Never commit .env.

# ---- Discovery: Google, LinkedIn and X results (via SerpApi) — https://serpapi.com
SERPAPI_KEY=

# ---- LLM: any model. Choose provider and model in config.yaml (llm.provider / llm.model).
#   anthropic          -> key from LLM_API_KEY (or ANTHROPIC_API_KEY)
#   openai_compatible  -> key from LLM_API_KEY (may be empty for local models such as Ollama)
LLM_API_KEY=

# ---- Sending sequence emails — Brevo (recommended: open and click tracking)
BREVO_API_KEY=

# ---- Reply detection: IMAP login to the mailbox the sequence is sent from (Gmail / Outlook app password)
IMAP_HOST=imap.gmail.com
IMAP_USER=
IMAP_PASSWORD=

# ---- Optional: SMTP sending instead of Brevo (set outreach.provider: smtp in config.yaml). No open tracking.
SMTP_USER=
SMTP_PASSWORD=

# ---- Secret used to sign unsubscribe links and the Brevo webhook URL. Any long random string.
OUTREACH_SECRET=

# ---- Weekly top-N delivered by SMS (only if delivery.channel is sms and delivery.enabled is true)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
